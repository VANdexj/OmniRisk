<launch>

	<arg name="rviz" default="true" />
	<arg name="config_file" default="$(find m_detector)/config/mid360/mid360.yaml" />

	<rosparam command="load" file="$(arg config_file)" />
	<arg name="pred_file" default=""/>	
	<arg name="pc_file" default=""/>	
	<arg name="pc_topic" default="/livox/lidar"/>	

	<param name="dyn_obj/pred_file" type="string" value="$(arg pred_file)" />
	<param name="dyn_obj/pc_file" type="string" value="$(arg pc_file)" />
	<param name="dyn_obj/pc_topic" type="string" value="$(arg pc_topic)" />

	<node pkg="m_detector" type="display_prediction" name="display_prediction" output="screen" />

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find m_detector)/rviz/display.rviz" />
	</group>
 
  	  

</launch>
